# DomainItem is the template's example entity -- delete/rename this whole
# module (schema + resolvers + svc/ctrl + the proto service it calls) when
# bootstrapping a real domain.
type DomainItem {
    id: ID!
    name: String!
    status: DomainItemStatus!
}

enum DomainItemStatus {
    ACTIVE
    ARCHIVED
}

type DomainItemList {
    rows: [DomainItem!]!
    info: PaginationInfo!
}

type DeleteDomainItemResponse {
    success: Boolean!
}
